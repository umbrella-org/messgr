CONTROL_DATABASE_URL=postgres://messgr:messgr@localhost:5432/control
DATABASE_MAX_CONNECTIONS=20
MESSGR_PROFILE=dev
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=messgr-dev-root-token

# messgr-ingest (T-011) -- no defaults; the binary refuses to start without them.
# INGEST_LISTEN_ADDR=0.0.0.0:8443
# INGEST_TLS_CERT_FILE=/path/to/cert.pem
# INGEST_TLS_KEY_FILE=/path/to/key.pem
# INGEST_TLS_CLIENT_CA_FILE=/path/to/ca.pem

# messgr-dispatcher (T-013) -- no defaults except DISPATCHER_CHANNELS
# (sms); the binary refuses to start without the rest. VAULT_ROLE_ID and
# VAULT_WRAPPED_SECRET_ID come from `just provision`'s output for this
# tenant. DISPATCHER_<CHANNEL>_BASE_URL/_API_KEY are a dev stand-in for a
# real provider -- provider_config has no base_url column yet and its
# credential_path has no Vault KV reader (T-012 decisions 3-4).
# DISPATCHER_TENANT_SLUG=acme
# DISPATCHER_CHANNELS=sms
# DISPATCHER_SMS_BASE_URL=http://localhost:9091
# DISPATCHER_SMS_API_KEY=dev-key
# VAULT_ROLE_ID=<from just provision>
# VAULT_WRAPPED_SECRET_ID=<from just provision, single-use>
